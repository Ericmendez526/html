<html>
        <body>
                <form>
                        <h1 style = "color = blue";> Medical Form </h1>
                        <!-- Full Name -->
                        <label for = 'FullName'> First Name / M.I / Last Name </label>
                        <input type = "text" maxlength = '30' size = '10' id = 'FName' placeholder = "First Name" required>
                        <input type = "text" maxlength = '1' size = '3' id = 'MI' placeholder = "M.I">
                        <input type = "text" maxlength = '30' size = '10' id = 'LName' placeholder = "Last Name" required><br><br>
                        <!-- DOB -->
                        <label for = 'DOB'> Date Of Birth: </label> 
                        <input type = "text" maxlength = '10' id = 'DOB' placeholder = "MM/DD/YYYY" pattern="\d{2}/\d{2}/\d{4}" title ='Enter date as MM/DD/YYYY' required><br>
                        <!-- Gender -->
                        <p> Please Enter Your Gender</p>
                        <input type = 'radio' id = 'Male' name = 'Gender' value = 'Male' required>
                        <label for = 'Male'> Male </label>
                        <input type = 'radio' id = 'Female' name = 'Gender' value = 'Female'>
                        <label for = 'Female'> Female </label><br><br>
                        <!-- SSN -->
                        <label for = 'SSN'> Social Security Number: </label>
                        <input type = "Password" maxlength = '11' id = 'SSN' required><br><br>
